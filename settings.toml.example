# Пример файла пользовательских настроек.
#
# Скопируйте в `settings.toml` и раскомментируйте только те поля, которые
# хотите изменить относительно дефолтов (они зашиты в config_model.py).
# `settings.toml` не коммитится (см. .gitignore) — ваши правки остаются
# локальными. Окно Settings в UI (Этап 5) пишет сюда то же самое
# автоматически, но только «diff» от дефолтов — пустой файл = всё по
# дефолту.
#
# Формат: TOML. Секции совпадают с нижним регистром из
# docs/config_migration_map.md (paths, audio, vad, deepfilter, speech_gate,
# stt, stt.filter, stt.gigaam, llm, llm.ollama, llm.lmstudio, tts, tts.silero,
# tts.xtts, wake_word, commands, dictate, ui, reminders, ipc, logging).

# --- Пути / сессии ------------------------------------------------------------
# [paths]
# session_base_dir = "~/Shura"
# session_layout = "monthly"               # "monthly" — все заметки и скриншоты
#                                          # за месяц складываются в одну папку
#                                          # вида YYYY-MM. "per_session" —
#                                          # отдельная папка YYYY-MM-DD_HH-MM
#                                          # на каждый запуск (старое поведение).
# voice_commands_file = "config/voice_commands.toml"

# --- Заметки ------------------------------------------------------------------
# [notes]
# html_with_screenshot = false            # true — снимок в начале команды,
#                                         # TXT и HTML-журнал за месяц.
#                                         # PNG и миниатюры хранятся рядом с HTML.
#                                         # Флажок в Modern UI применяет без перезапуска.

# --- STT / Whisper ------------------------------------------------------------
# [stt]
# provider = "whisper"                    # или "gigaam" — GigaAM-v3 (Сбер), только
#                                         # русский; зависимости: requirements-gigaam.txt.
#                                         # Переключатель есть в Modern UI → «Настройки»;
#                                         # смена модели — после перезапуска.
# whisper_model_size = "large-v3-turbo"   # или "large-v3" для максимального качества
# whisper_device = "cuda"                 # "cpu" если нет CUDA
# whisper_language = "russian"

# [stt.gigaam]
# model = "ai-sage/GigaAM-v3"
# revision = "e2e_rnnt"                   # e2e_rnnt / e2e_ctc — с пунктуацией;
#                                         # rnnt / ctc — без пунктуации
# device = "cuda"                         # "cpu" если нет CUDA
# max_chunk_s = 22.0                      # модель принимает до 25 с; длиннее — режем по паузам

# --- Фильтр речи перед распознаванием (Silero VAD) ----------------------------
# Фрагменты без речи (тишина, щелчки, дыхание) не отправляются в Whisper —
# главная защита от «Продолжение следует…». Нужен пакет silero-vad.
# [speech_gate]
# enabled = true
# threshold = 0.5                         # 0..1: выше — строже к шуму, но может
#                                         # пропускать тихую речь
# min_speech_ms = 250                     # меньше речи во фрагменте — не распознаём
# speech_pad_ms = 200                     # запас вокруг найденной речи
# min_silence_ms = 300                    # паузы короче не разрывают речь
# wake_scan = true                        # проверять и окна поиска кодового слова

# --- Очистка текста от галлюцинаций -------------------------------------------
# Сегменты Whisper с признаками неречи отбрасываются, типовые фразы субтитров
# вырезаются, зацикленные повторы схлопываются. Решения пишутся в
# logs/voice_ai.log (строки «Фильтр галлюцинаций», «Фильтр речи»).
# [stt.filter]
# enabled = true                          # false — текст модели без обработки
# no_speech_threshold = 0.6               # отбросить сегмент, если no_speech_prob
# logprob_threshold = -0.5                # выше порога И avg_logprob ниже порога
# no_speech_hard_threshold = 0.9          # отбросить сегмент при no_speech_prob выше
# compression_ratio_threshold = 2.4       # выше — зацикленный повтор
# suspicious_no_speech = 0.3              # «Спасибо», «Пока» в диктовке удаляются
#                                         # только при таком сомнении модели
# max_repeats = 3                         # больше повторов подряд — схлопнуть
# extra_phrases = ["всем добра"]          # свои фразы-галлюцинации

# --- LLM ----------------------------------------------------------------------
# [llm]
# provider = "lmstudio"                    # или "ollama"
# timeout = 120
# max_tokens = 300

# [llm.ollama]
# base_url = "http://localhost:11434"
# model = "gemma-4-coder"

# [llm.lmstudio]
# base_url = "http://localhost:1234"
# model = ""                              # пусто = автовыбор единственной загруженной модели

# --- TTS ----------------------------------------------------------------------
# [tts]
# provider = "silero"                      # или "xtts"
# language = "ru"

# [tts.silero]
# speaker = "xenia"                        # xenia / baya / kseniya / aidar / eugene
# sample_rate = 48000                      # 8000 / 24000 / 48000
# intensity = 3                            # 1..5 — сила вопросительной интонации (v5)

# [tts.xtts]
# device = "cuda"
# speaker_name = "Claribel Dervla"

# --- Wake-word ----------------------------------------------------------------
# [wake_word]
# word = "шурочка"
# aliases = ["шура"]
# enabled_at_startup = false
# hotkey = "<ctrl>+<alt>+s"                # pynput-формат; пустая строка = выключить

# --- VAD / калибровка ---------------------------------------------------------
# [vad]
# min_energy_threshold = 150
# pause_threshold = 1.0
# calibration_duration = 2.0

# --- Голосовые команды --------------------------------------------------------
# [commands]
# strict_config = true                    # true = ошибка в voice_commands.toml останавливает запуск
# allow_disable_global = false            # защита StopCommand от случайного отключения

# --- DeepFilterNet ------------------------------------------------------------
# [deepfilter]
# enabled = false                          # включать после приёмки check_stage_9.py
# device = "cuda"                          # "cpu" если XTTS занимает CUDA

# --- UI / overlay / tray ------------------------------------------------------
# [ui]
# overlay_enabled = true
# overlay_position = "top_right"           # top_right / top_left / bottom_right / bottom_left
# overlay_alpha = 0.85
# tray_enabled = true

# Полноэкранная шпаргалка с командами при пробуждении ("Шурочка ...").
# Появляется на 1.5 с поверх всех окон и плавно растворяется. Click-through —
# не перехватывает мышь. Список берётся из config/voice_commands.toml
# (hint/show_in_hints/order), затем из legacy config/wake_hints.json, затем
# автоматически из реестра команд.
# [ui.wake_hint]
# enabled = true
# trigger_state = "wake_active"           # "wake_heard" — раньше / "wake_active" — пока ждёт фразу
# hold_ms = 1500                          # сколько висеть после fade-in
# fade_in_ms = 150
# fade_out_ms = 250
# opacity = 0.55                          # 0.0–1.0, общая прозрачность окна
# font_pt = 32
# max_items = 10
# monitor = "cursor"                      # "cursor" / "primary"
# vertical_align = "center"               # "center" / "top" / "bottom"
# text_color = "#1a1a1a"                  # CSS hex, цвет букв
# shadow_enabled = true                   # halo вокруг букв для читаемости на любом фоне
# shadow_color = "#ffffff"                # обычно противоположный text_color
# shadow_blur = 16
# backdrop_enabled = true                 # подложка-карточка под буквами
# backdrop_color = "#fdf6e3"              # солнечный песочный (solarized base3)

# --- IPC ----------------------------------------------------------------------
# [ipc]
# host = "127.0.0.1"
# port = 9999

# --- Logging ------------------------------------------------------------------
# [logging]
# level = "INFO"                           # DEBUG / INFO / WARNING / ERROR
